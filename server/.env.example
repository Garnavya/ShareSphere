# Server Runtime Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL)
DATABASE_URL="mysql://sharesphere_user:sharesphere_pass@localhost:3306/sharesphere_db"

# JWT Authentication
JWT_SECRET="your_secure_random_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Cloudinary CDN Configuration (For Item & Handover Condition Photos)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# OTP Settings
OTP_EXPIRY_MINUTES=15
