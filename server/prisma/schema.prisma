datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  DELIVERY_PARTNER
  ADMIN
}

enum ItemCondition {
  BRAND_NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  AWAITING_HANDOVER
  ACTIVE
  RETURN_REQUESTED
  RETURN_IN_PROGRESS
  RETURNED
  COMPLETED
  CANCELLED
  REJECTED
  OVERDUE
  DISPUTED
}

enum FulfillmentType {
  SELF_PICKUP
  DELIVERY_PARTNER
}

enum DeliveryPhase {
  OUTBOUND
  RETURN
}

enum DeliveryStatus {
  PENDING
  AVAILABLE
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ConditionStage {
  PRE_HANDOVER
  POST_RETURN
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String
  phone           String?
  role            Role           @default(USER)
  rating          Float          @default(5.0)
  ratingCount     Int            @default(0)
  avatarUrl       String?
  address         String?
  latitude        Float?
  longitude       Float?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  itemsOwned      Item[]         @relation("ItemOwner")
  borrowings      Booking[]      @relation("BorrowerBookings")
  deliveries      DeliveryTask[] @relation("PartnerDeliveries")
  conditionLogs   ConditionLog[] @relation("UserConditionLogs")
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  auditLogs       AuditLog[]

  @@map("users")
}

model Item {
  id              String         @id @default(uuid())
  title           String
  description     String         @db.Text
  category        String
  condition       ItemCondition  @default(GOOD)
  dailyRate       Decimal        @default(0.00) @db.Decimal(10, 2)
  securityDeposit Decimal        @default(0.00) @db.Decimal(10, 2)
  isFree          Boolean        @default(false)
  isAvailable     Boolean        @default(true)
  address         String
  latitude        Float?
  longitude       Float?
  ownerId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  owner           User           @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  images          ItemImage[]
  bookings        Booking[]

  @@index([category])
  @@index([ownerId])
  @@map("items")
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_images")
}

model Booking {
  id              String          @id @default(uuid())
  itemId          String
  borrowerId      String
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  totalAmount     Decimal         @db.Decimal(10, 2)
  status          BookingStatus   @default(PENDING)
  fulfillmentType FulfillmentType @default(SELF_PICKUP)
  pickupOtp       String?         // Hashed short-lived numeric OTP
  returnOtp       String?         // Hashed short-lived numeric OTP
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relationships
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrower        User            @relation("BorrowerBookings", fields: [borrowerId], references: [id], onDelete: Restrict)
  deliveryTasks   DeliveryTask[]
  conditionLogs   ConditionLog[]
  reviews         Review[]

  @@index([itemId, startDate, endDate])
  @@index([borrowerId])
  @@index([status])
  @@map("bookings")
}

model DeliveryTask {
  id              String         @id @default(uuid())
  bookingId       String
  partnerId       String?
  phase           DeliveryPhase  @default(OUTBOUND)
  status          DeliveryStatus @default(PENDING)
  pickupAddress   String
  dropoffAddress  String
  deliveryFee     Decimal        @default(0.00) @db.Decimal(10, 2)
  notes           String?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partner         User?          @relation("PartnerDeliveries", fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([partnerId])
  @@index([status])
  @@map("delivery_tasks")
}

model ConditionLog {
  id          String         @id @default(uuid())
  bookingId   String
  loggedById  String
  stage       ConditionStage
  notes       String?        @db.Text
  imageUrls   Json           // Array of Cloudinary photo URLs
  createdAt   DateTime       @default(now())

  // Relationships
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  loggedBy    User           @relation("UserConditionLogs", fields: [loggedById], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("condition_logs")
}

model Review {
  id                   String   @id @default(uuid())
  bookingId            String
  reviewerId           String
  revieweeId           String
  overallRating        Int      // 1 to 5 stars
  punctualityRating    Int?     // 1 to 5 stars
  conditionRating      Int?     // 1 to 5 stars
  communicationRating  Int?     // 1 to 5 stars
  comment              String?  @db.Text
  createdAt            DateTime @default(now())

  // Relationships
  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer             User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee             User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([revieweeId])
  @@map("reviews")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
